# Local development. Copy to backend/.env
DATABASE_URL=mysql+pymysql://leave:leave@localhost:3306/leave_mgmt?charset=utf8mb4
# Zero-setup alternative: DATABASE_URL=sqlite:///./local.db
AUTH_MODE=dev
EMAIL_ENABLED=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# To test real Cognito / SES locally instead:
# AUTH_MODE=cognito
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXX
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
# EMAIL_ENABLED=true
# SES_REGION=us-east-1
# SES_SENDER=LeaveDesk <leave@yourcompany.com>
