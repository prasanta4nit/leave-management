# "dev" shows an employee picker and sends X-Dev-User (backend must run with AUTH_MODE=dev).
# "cognito" uses the Cognito user pool below.
VITE_AUTH_MODE=dev
VITE_API_BASE_URL=/api
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Where `npm run dev` proxies /api (local uvicorn)
VITE_API_PROXY_TARGET=http://localhost:8001
